// FIXED: Corrected dist() helper function formatting string concatenation
function dist(n) { 
  if (n >= 1e9) return (n / 1e9).toFixed(2) + " Gm";
  if (n >= 1e6) return (n / 1e6).toFixed(1) + " Mm";
  if (n >= 1e3) return (n / 1e3).toFixed(1) + " km";
  return fmt(n) + " m";
}

function stages(legs, con) {
  const box = document.getElementById("stages");
  if (!legs.length) { box.innerHTML = `<div class="stat"><div class="lbl">Stages</div><div class="big">—</div><div class="lbl">Pick a route.</div></div>`; return; }
  const pad = 1 + con / 100;
  const buckets = { Launch: [], Transfer: [], Lander: [], Return: [] };
  legs.forEach(l => l.bits.forEach(bit => {
    const n = bit[0];
    const key = n === "Launch" ? "Launch" : /Ascent/.test(n) ? "Lander" : l.ret ? "Return" : /Land/.test(n) ? "Lander" : "Transfer";
    buckets[key].push(bit);
  }));
  const shield = name => {
    const anyDirect = route.some(s => {
      const body = raw[s.name];
      return body && s.mode === "land" && body.atm && !document.getElementById("orbitFirst").checked;
    });
    const usedAero = document.getElementById("aeroIn").checked || anyDirect;
    if (name === "Transfer" && usedAero && legs.some(l => !l.ret && raw[l.name] && raw[l.name].atm)) return "Heat shield on arriving ship.";
    if (name === "Return" && document.getElementById("aeroHome").checked) return "Heat shield for Kerbin return.";
    if (name === "Lander" && legs.some(l => l.mode === "land" && raw[l.name] && raw[l.name].atm && !l.ret)) return "Atmosphere on landing.";
    return "No heat shield.";
  };
  box.innerHTML = ["Launch", "Transfer", "Lander", "Return"].filter(k => buckets[k].length).map(k => {
    const rawDv = buckets[k].reduce((s, b) => s + b[1], 0);
    const dv = k === "Launch" ? rawDv : rawDv * pad;
    return `<div class="stat"><div class="lbl">${k}</div><div class="big">${fmt(dv)} m/s</div><div class="lbl">${buckets[k].map(b => b[0]).join(" · ")}</div><div class="lbl">${shield(k)}</div></div>`;
  }).join("");
}

function sciencePower() {
  const box = document.getElementById("sciencePower");
  const stop = route.length ? route[route.length - 1] : null;
  const targetName = stop && (raw[stop.name] || stop.name === "Kerbol") ? stop.name : "";
  const counts = ANT.map((a, i) => Number(document.getElementById("ant" + i)?.textContent) || 0);
  const selected = counts.map((c, i) => ({ i, c, name: ANT[i][0], pkt: PKT[i] })).filter(a => a.c > 0);
  if (!targetName || !selected.length) {
    box.innerHTML = `<div class="stat" style="grid-column:1/-1"><div class="lbl">${!targetName ? "Pick a destination on the map" : "Select an antenna above"}</div></div>`;
    return;
  }
  // Prefer the most EC-efficient antenna among those that can actually reach the far side
  const far = (() => {
    const body = raw[targetName] || { sma: 0, parent: "Kerbol", r: 261600000 };
    if (body.home) return 0;
    const sma = body.parent === "Kerbin" ? 0 : body.parent === "Kerbol" ? body.sma : raw[body.parent].sma;
    const moon = body.parent === "Kerbol" || body.parent === "Kerbin" ? (body.parent === "Kerbin" ? body.sma : 0) : body.sma;
    return body.parent === "Kerbin" ? body.sma : sma + KB.sma + moon;
  })();
  const dsnG = Number(document.querySelector("#dsn button.on")?.dataset.g || 250);
  const reachable = selected.filter(a => {
    const range = Math.sqrt(ANT[a.i][1] * dsnG * 1e9);
    return range >= far;
  });
  const pool = reachable.length ? reachable : selected;
  const best = pool.reduce((a, b) => (a.pkt.cost / a.pkt.size) <= (b.pkt.cost / b.pkt.size) ? a : b);
  const b = raw[targetName] || { r: 261600000, atm: 0 }; // Kerbol fallback
  const mode = stop.mode || "orbit";
  const aeroIn = document.getElementById("aeroIn")?.checked || false;
  const pkt = best.pkt;
  const antName = best.name;
  const radiusKm = b.r / 1000;
  const isKerbolOrbit = targetName === "Kerbol" && mode === "orbit";
  const canLand = mode === "land";
  const canAtm = b.atm > 0 && (canLand || aeroIn);
  const list = [
    ...EXPERIMENTS.filter(e => {
      if (e.name === "Seismic Scan" || e.name === "Surface Sample") return canLand;
      if (e.name === "Atmosphere Analysis") return canAtm;
      if (e.name === "Infrared Telescope") return isKerbolOrbit;
      return true;
    }),
    ...(isKerbolOrbit ? [] : [
      { name: "M700 Resource Scan", mits: Math.round((b.r / 1000) * 0.205) },
      { name: "M700 Science Report", mits: 20 }
    ])
  ];
  const rows = list.map(e => {
    const packets = Math.ceil(e.mits / pkt.size);
    const ec = packets * pkt.cost;
    return `<div class="stat"><div class="lbl">${e.name}</div><div class="big">${fmt(ec)} EC</div><div class="lbl">${e.mits} Mits · ${packets} packets</div></div>`;
  }).join("");
  const modeNote = mode === "land" ? "landing" : mode === "orbit" ? "orbit" : "fly-by";
  const antList = selected.map(a => a.name + (a.c > 1 ? " ×" + a.c : "")).join(", ");
  box.innerHTML = `<div class="stat" style="grid-column:1/-1"><div class="lbl">${targetName} (${modeNote})</div><div class="lbl">Antennas: ${antList}</div><div class="lbl">Numbers use most efficient: ${antName}</div></div>` + rows;
}

function antennas() {
  const counts = ANT.map((a, i) => Number(document.getElementById("ant" + i).textContent) || 0);
  sciencePower();
  let sum = 0, best = 0, wExp = 0;
  ANT.forEach((a, i) => { 
    const p = a[1] * counts[i]; 
    sum += p; 
    if (a[1] > best && counts[i]) best = a[1]; 
    wExp += p * a[2]; 
  });
  const power = best ? best * Math.pow(sum / best, wExp / sum) : 0;
  const targetName = route.length && raw[route[route.length - 1].name] ? route[route.length - 1].name : "";

  if (!power) {
    document.getElementById("rng").textContent = "—";
    document.getElementById("verdict").textContent = "Select an antenna.";
    if (!targetName) {
      document.getElementById("near").textContent = "—";
      document.getElementById("far").textContent = "—";
      document.getElementById("nearLbl").textContent = "Closest to Kerbin";
      document.getElementById("farLbl").textContent = "Farthest from Kerbin";
    } else {
      const body = raw[targetName];
      if (body.home) {
        document.getElementById("near").textContent = "—";
        document.getElementById("far").textContent = "—";
        document.getElementById("nearLbl").textContent = "Kerbin (local)";
        document.getElementById("farLbl").textContent = "Kerbin (local)";
      } else {
        const sma = body.parent === "Kerbin" ? 0 : body.parent === "Kerbol" ? body.sma : raw[body.parent].sma;
        const moon = body.parent === "Kerbol" || body.parent === "Kerbin" ? (body.parent === "Kerbin" ? body.sma : 0) : body.sma;
        const near = body.parent === "Kerbin" ? body.sma : Math.abs(sma - KB.sma) - moon;
        const far = body.parent === "Kerbin" ? body.sma : sma + KB.sma + moon;
        document.getElementById("near").textContent = dist(Math.max(near, 0));
        document.getElementById("far").textContent = dist(far);
        document.getElementById("nearLbl").textContent = targetName + ", closest to Kerbin";
        document.getElementById("farLbl").textContent = targetName + ", farthest from Kerbin";
      }
    }
    return;
  }

  if (!targetName) {
    document.getElementById("near").textContent = "—";
    document.getElementById("far").textContent = "—";
    document.getElementById("nearLbl").textContent = "Closest to Kerbin";
    document.getElementById("farLbl").textContent = "Farthest from Kerbin";
    document.getElementById("rng").textContent = dist(Math.sqrt(power * dsnG * 1e9));
    document.getElementById("verdict").textContent = "Pick a body on the map.";
    return;
  }

  const body = raw[targetName];
  if (body.home) {
    document.getElementById("near").textContent = "—";
    document.getElementById("far").textContent = "—";
    document.getElementById("nearLbl").textContent = "Kerbin (local)";
    document.getElementById("farLbl").textContent = "Kerbin (local)";
    document.getElementById("rng").textContent = dist(Math.sqrt(power * dsnG * 1e9));
    document.getElementById("verdict").textContent = "Local to Kerbin.";
    return;
  }
  const sma = body.parent === "Kerbin" ? 0 : body.parent === "Kerbol" ? body.sma : raw[body.parent].sma;
  const moon = body.parent === "Kerbol" || body.parent === "Kerbin" ? (body.parent === "Kerbin" ? body.sma : 0) : body.sma;
  const near = body.parent === "Kerbin" ? body.sma : Math.abs(sma - KB.sma) - moon;
  const far = body.parent === "Kerbin" ? body.sma : sma + KB.sma + moon;
  document.getElementById("near").textContent = dist(Math.max(near, 0));
  document.getElementById("far").textContent = dist(far);
  document.getElementById("nearLbl").textContent = targetName + ", closest to Kerbin";
  document.getElementById("farLbl").textContent = targetName + ", farthest from Kerbin";

  const range = Math.sqrt(power * dsnG * 1e9);
  document.getElementById("rng").textContent = dist(range);
  document.getElementById("verdict").innerHTML = range >= far ? "<p class='ok'>Reaches Kerbin from the far side.</p>" : range >= near ? "<p class='ok'>Reaches Kerbin only on the near side.</p>" : "<p class='bad'>Does not reach Kerbin.</p>";
}

document.getElementById("clear").onclick = () => {
  route = []; warn = "";
  kerbinChuteDefaulted = false;
  ["fromLko", "round", "aeroIn", "aeroHome", "chute", "chuteKerbin", "orbitFirst", "orbitFirstKerbin"].forEach(id => { document.getElementById(id).checked = false; });
  document.getElementById("con").value = 0;
  document.getElementById("di").value = 0;
  document.getElementById("diInOrbit").checked = false;
  document.getElementById("apo").value = "";
  document.getElementById("relAlt").value = "";
  render();
};
["fromLko", "round", "aeroIn", "aeroHome", "chute", "chuteKerbin", "orbitFirst", "orbitFirstKerbin"].forEach(id => document.getElementById(id).addEventListener("change", render));
let dsnG = 250;
document.getElementById("dsn").addEventListener("click", e => {
  const btn = e.target.closest("button");
  if (!btn) return;
  dsnG = Number(btn.dataset.g);
  document.querySelectorAll("#dsn button").forEach(b => b.classList.toggle("on", b === btn));
  antennas();
});
document.getElementById("con").addEventListener("input", render);
document.getElementById("diAuto").addEventListener("click", () => {
  const focus = route.length && raw[route[route.length - 1].name];
  if (focus && focus.inc) {
    document.getElementById("di").value = String(focus.inc);
    render();
  }
});
["di", "apo"].forEach(id => document.getElementById(id).addEventListener("input", render));
document.getElementById("diInOrbit").addEventListener("change", render);
const svg = document.getElementById("map");
svg.addEventListener("click", e => {
  const n = e.target.closest(".node");
  if (n) add(n.dataset.id);
});
svg.addEventListener("pointerover", e => {
  const n = e.target.closest(".node");
  if (!n) return;
  const name = n.dataset.id.split(":")[0];
  const b = raw[name];
  const tip = document.getElementById("tip");
  if (!b) { tip.style.display = "none"; return; }
  const g = b.mu / (b.r * b.r);
  tip.innerHTML = `<b>${name}</b><br>Gravity ${(g / 9.81).toFixed(2)} g<br>Atmosphere ${b.atm || 0} km<br>SOI ${Math.round((b.soi - b.r) / 1000).toLocaleString("en-US")} km`;
  tip.style.display = "block";
  const r = document.querySelector(".stage").getBoundingClientRect();
  tip.style.left = (e.clientX - r.left + 12) + "px";
  tip.style.top  = (e.clientY - r.top  + 12) + "px";
});
svg.addEventListener("pointermove", e => {
  const tip = document.getElementById("tip");
  if (tip.style.display === "block") {
    const r = document.querySelector(".stage").getBoundingClientRect();
    tip.style.left = (e.clientX - r.left + 12) + "px";
    tip.style.top  = (e.clientY - r.top  + 12) + "px";
  }
});
svg.addEventListener("pointerout", e => {
  const related = e.relatedTarget;
  if (!related || !related.closest || !related.closest(".node")) {
    document.getElementById("tip").style.display = "none";
  }
});
// Delayed hover tips for the planning toggles and other marked areas (same style as map nodes)
let tipTimer = null;
document.querySelectorAll("[data-tip]").forEach(lab => {
  const place = (e, tip) => {
    const r = document.querySelector(".stage").getBoundingClientRect();
    const leftSide = lab.dataset.tipSide === "left";
    const offset = leftSide ? -Math.min(280, tip.offsetWidth + 16) : 14;
    tip.style.left = (e.clientX - r.left + offset) + "px";
    tip.style.top  = (e.clientY - r.top + 14) + "px";
  };
  lab.addEventListener("pointerenter", e => {
    clearTimeout(tipTimer);
    tipTimer = setTimeout(() => {
      const tip = document.getElementById("tip");
      tip.innerHTML = lab.dataset.tip;
      tip.style.display = "block";
      place(e, tip);
    }, 600);
  });
  lab.addEventListener("pointermove", e => {
    const tip = document.getElementById("tip");
    if (tip.style.display === "block" && tip.innerHTML === lab.dataset.tip) place(e, tip);
  });
  lab.addEventListener("pointerleave", () => {
    clearTimeout(tipTimer);
    const tip = document.getElementById("tip");
    if (tip.innerHTML === lab.dataset.tip) tip.style.display = "none";
  });
});
const view = { x: 80, y: 20, w: 940, h: 660 };
function clampView() {
  const minX = -120, maxX = 1220, minY = -200, maxY = 900;
  view.x = Math.min(maxX - view.w * 0.35, Math.max(minX - view.w * 0.65, view.x));
  view.y = Math.min(maxY - view.h * 0.35, Math.max(minY - view.h * 0.65, view.y));
}
function applyView() {
  const box = svg.getBoundingClientRect();
  if (box.width && box.height) view.h = view.w * box.height / box.width;
  clampView();
  svg.setAttribute("viewBox", view.x + " " + view.y + " " + view.w + " " + view.h);
}
svg.addEventListener("wheel", e => {
  e.preventDefault();
  const box = svg.getBoundingClientRect();
  const px = view.x + (e.clientX - box.left) / box.width * view.w;
  const py = view.y + (e.clientY - box.top) / box.height * view.h;
  const next = Math.min(1300, Math.max(360, view.w * (e.deltaY < 0 ? 0.9 : 1.12)));
  const scale = next / view.w;
  view.x = px - (px - view.x) * scale; view.y = py - (py - view.y) * scale; view.w = next;
  applyView();
}, { passive: false });
let drag = null;
svg.addEventListener("pointerdown", e => {
  if (e.target.closest(".node")) return;
  drag = { x: e.clientX, y: e.clientY, vx: view.x, vy: view.y };
  svg.setPointerCapture(e.pointerId);
});
svg.addEventListener("pointermove", e => { if (!drag) return; const box = svg.getBoundingClientRect(); view.x = drag.vx - (e.clientX - drag.x) / box.width * view.w; view.y = drag.vy - (e.clientY - drag.y) / box.height * view.h; applyView(); });
svg.addEventListener("pointerup", () => { drag = null; });
svg.addEventListener("pointercancel", () => { drag = null; });
applyView();
window.addEventListener("resize", applyView);
render();
</script>

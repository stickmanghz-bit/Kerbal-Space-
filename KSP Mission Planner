  const vInf = homeBody && homeBody.parent !== "Kerbin" ? (kerbinTo(homeBody.parent === "Kerbol" ? route[route.length - 1].name : homeBody.parent).vInfHome || 0) : 0;
  const entry = vInf ? Math.sqrt(vInf * vInf + 2 * KB.mu / (KB.r + 35000)) : 0;
  document.getElementById("warn").textContent = warn || (entry > 3500 ? "Kerbin entry " + fmt(entry) + " m/s. One pass may not be enough." : "");
  const hasLand = route.some(s => s.mode === "land");
  const hasDest = route.length > 0;
  const hasAtmLand = route.some(s => {
    const b = raw[s.name];
    return b && s.mode === "land" && b.atm;
  });
  // Nothing selectable except Start in LKO until a destination is chosen
  const lockAll = !hasDest;
  const setLock = (id, locked, forceOff) => {
    const lab = document.querySelector("label:has(#" + id + ")");
    const cb = document.getElementById(id);
    if (!lab || !cb) return;
    lab.style.opacity = locked ? "0.4" : "1";
    cb.disabled = locked;
    if (locked && forceOff) cb.checked = false;
  };
  setLock("round", lockAll, true);
  setLock("aeroIn", lockAll || !hasAnyAtm, true);
  setLock("aeroHome", lockAll || !round, true);
  setLock("chute", lockAll || !hasAtmLand, true);
  setLock("chuteKerbin", lockAll || !round, true);
  setLock("orbitFirst", lockAll || !hasLand, true);
  setLock("orbitFirstKerbin", lockAll || !round, true);
  // Aerobrake Home locked on unless Orbit Before Landing (Kerbin) is selected
  if (round && !orbitFirstKerbin) {
    document.getElementById("aeroHome").checked = true;
    document.getElementById("aeroHome").disabled = true;
    const ah = document.querySelector("label:has(#aeroHome)");
    if (ah) ah.style.opacity = "0.7";
  } else if (round && orbitFirstKerbin) {
    document.getElementById("aeroHome").disabled = false;
    const ah = document.querySelector("label:has(#aeroHome)");
    if (ah) ah.style.opacity = "1";
  }
  const origin = fromLko ? "Kerbin — Low orbit" : "Kerbin — Surface";
  document.getElementById("journey").innerHTML = `<div class="origin"><i class="dot" style="background:#3c95d4"></i>${origin}</div>` + legs.map((l, i) => `
    <div class="card"><span>Leg ${i + 1}</span><span></span><span>ΔV</span><b>${fmt((() => { const launchBit = l.bits.filter(b => b[0] === "Launch").reduce((a, b) => a + b[1], 0); return launchBit + (l.dv - launchBit) * (1 + con / 100); })())} m/s</b><span>Transfer</span><b>${l.angle ? l.angle.toFixed(1) + "°" : "—"}</b></div>
    <div class="stop"><i class="dot" style="background:${l.color}"></i><div style="flex:1">${l.name} — ${modeLabel(l.mode)}${l.path ? " (" + l.path + ")" : ""}<div style="color:#8b93a7;font-size:12px">${l.bits.map(b => b[0] + " " + fmt(b[1])).join(" · ")}</div></div>${l.ret ? "" : `<button class="rm" data-i="${i}">Remove</button>`}</div>`).join("");
  document.querySelectorAll(".rm").forEach(btn => btn.onclick = () => {
    const i = Number(btn.dataset.i);
    const removed = route[i];
    route.splice(i, 1);
    // Cascade: remove any later stops whose parent was the removed body
    if (removed) {
      for (let j = route.length - 1; j >= i; j--) {
        const b = raw[route[j].name];
        if (b && b.parent === removed.name) route.splice(j, 1);
      }
    }
    document.getElementById("relAlt").value = "";
    render();
  });
  antennas();
  mission();
  stages(legs, con);
  draw();
}


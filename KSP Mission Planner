function kDays(sec) { return (sec / 21600).toFixed(1); }
const peKm = { Kerbin: 35, Eve: 72, Duna: 15, Laythe: 22, Jool: 145 };

function mission() {
  // Use the same first non-Kerbin heliocentric body that ejectAng uses
  const planetBody = route.map(s => raw[s.name]).find(b => b && b.parent === "Kerbol" && !b.home);
  const named = planetBody ? Object.keys(raw).find(n => raw[n] === planetBody) : (route.length && raw[route[route.length - 1].name] ? route[route.length - 1].name : "");
  if (!named) {
    document.getElementById("winBody").textContent = "Window";
    document.getElementById("phase").textContent = "—";
    document.getElementById("phaseBack").textContent = "—";
    document.getElementById("winTo").innerHTML = windowFig(null);
    document.getElementById("winFrom").innerHTML = windowFig(null);
    document.getElementById("coast").textContent = "—";
    document.getElementById("syn").textContent = "—";
    document.getElementById("relPer").textContent = "—";
    document.getElementById("relGap").textContent = "—";
    document.getElementById("relLink").textContent = "—";
    document.getElementById("relResAlt").textContent = "—";
    document.getElementById("relBus").textContent = "—";
    document.getElementById("relDvManeuver").textContent = "—";
    document.getElementById("relDvTotal").textContent = "—";
    document.getElementById("relFig").innerHTML = "";
    document.getElementById("relNote").textContent = "Pick a body on the map.";
    document.getElementById("relAlt").placeholder = "auto";
    document.getElementById("pe").textContent = "—";
    document.getElementById("peNote").textContent = "";
    document.getElementById("peBack").textContent = "—";
    document.getElementById("peBackNote").textContent = "";
    return;
  }
  const target = named;
  const b = raw[target];
  const planet = b.home ? null : b.parent === "Kerbol" ? b : b.parent === "Kerbin" ? null : raw[b.parent];
  if (!planet) {
    document.getElementById("winBody").textContent = target;
    document.getElementById("phase").textContent = "Local";
    document.getElementById("phaseBack").textContent = "—";
    document.getElementById("winTo").innerHTML = windowFig(null);
    document.getElementById("winFrom").innerHTML = windowFig(null);
    document.getElementById("coast").textContent = "—";
    document.getElementById("syn").textContent = "—";
  } else {
    const a = (KB.sma + planet.sma) / 2;
    const coast = Math.PI * Math.sqrt(a ** 3 / SUN);
    const pK = 2 * Math.PI * Math.sqrt(KB.sma ** 3 / SUN);
    const pT = 2 * Math.PI * Math.sqrt(planet.sma ** 3 / SUN);
    const syn = 1 / Math.abs(1 / pK - 1 / pT);
    const isOuter = planet.sma > KB.sma;
    document.getElementById("winBody").textContent = planet === b ? target : target + " via " + b.parent;
    document.getElementById("phase").textContent = phase(planet.sma).toFixed(1) + "°";
    document.getElementById("phaseBack").textContent = phaseBack(planet.sma).toFixed(1) + "°";
    document.getElementById("winTo").innerHTML = windowFig(phase(planet.sma), planet.color, true, isOuter);
    document.getElementById("winFrom").innerHTML = document.getElementById("round").checked ? windowFig(phaseBack(planet.sma), planet.color, false, isOuter) : windowFig(null);
    if (!document.getElementById("round").checked) document.getElementById("phaseBack").textContent = "—";
    document.getElementById("coast").textContent = kDays(coast);
    document.getElementById("syn").textContent = kDays(syn);
  }
  const aeroOn = document.getElementById("aeroIn").checked;
  const homeOn = document.getElementById("aeroHome").checked && document.getElementById("round").checked;
  const anyDirect = route.some(s => {
    const bb = raw[s.name];
    return bb && s.mode === "land" && bb.atm && !document.getElementById("orbitFirst").checked;
  });
  const aeroStops = (aeroOn || anyDirect) ? route.filter(s => s.mode !== "fly" && peKm[s.name]).map(s => s.name + " " + peKm[s.name] + " km") : [];
  const destPe = aeroStops.join(" · ");
  const homePe = homeOn ? "Kerbin " + peKm.Kerbin + " km" : "";
  document.getElementById("pe").textContent = destPe || "—";
  document.getElementById("peNote").textContent = destPe ? "Set at the body with air, even if a moon is the last stop." : (anyDirect ? "Direct entry forces aerobrake." : "Turn on arrival aerobrake.");
  document.getElementById("peBack").textContent = homePe || "—";
  document.getElementById("peBackNote").textContent = homePe ? "Kerbin return." : "No return aerobrake.";
  
  const host = b;
  const hostName = target;
  const edge = (host.soi - host.r) / 1000;
  const nCraft = Number(document.querySelector("#relays button.on")?.dataset.n || "3");
  const mode = document.querySelector("#relMode button.on")?.dataset.m || "in";
  const atmo = host.atm || 10;
  // For 2 sats (polar pair) the equatorial LOS formula divides by cos(90°)=0; skip it
  const isPolar = nCraft === 2;
  const losAlt = isPolar ? 0 : host.r * (1 / Math.cos(Math.PI / nCraft) - 1) / 1000;
  const floor = Math.max(atmo, losAlt);
  let alt = Number(String(document.getElementById("relAlt").value).replace(/,/g, ""));
  const autoAlt = Math.max(floor + 5, edge * 0.25);
  const relAltEl = document.getElementById("relAlt");
  if (relAltEl.value.trim() === "" || !Number.isFinite(alt)) {
    alt = autoAlt;
    relAltEl.placeholder = Math.round(autoAlt).toLocaleString("en-US");
  } else {
    relAltEl.placeholder = "auto";
  }
  const problems = [];
  
  if (!Number.isFinite(alt)) problems.push("Enter an altitude.");
  else {
    if (alt <= atmo) problems.push("Inside the atmosphere.");
    if (!isPolar && alt < losAlt) problems.push("Planet blocks the link. Need at least " + Math.ceil(losAlt).toLocaleString("en-US") + " km.");
    if (alt > edge) problems.push("Outside the SOI.");
  }
  
  const rFinal = host.r + (Number.isFinite(alt) ? alt : floor) * 1000;
  const tFinal = 2 * Math.PI * Math.sqrt(rFinal ** 3 / host.mu);
  const link = 2 * rFinal * Math.sin(Math.PI / nCraft);
  
  let tBus, rRes, resAltLabel, maneuverDv;
  if (mode === "in") {
    tBus = tFinal * ((nCraft - 1) / nCraft);
    const aBus = Math.pow(host.mu * Math.pow(tBus / (2 * Math.PI), 2), 1 / 3);
    rRes = 2 * aBus - rFinal;
    resAltLabel = "Resonant Pe: " + ((rRes - host.r) / 1000).toFixed(1) + " km";
    const vFinal = circ(host.mu, rFinal);
    const vAp = Math.sqrt(Math.max(0, host.mu * (2 / rFinal - 1 / aBus)));
    maneuverDv = Math.abs(vFinal - vAp);
  } else {
    tBus = tFinal * ((nCraft + 1) / nCraft);
    const aBus = Math.pow(host.mu * Math.pow(tBus / (2 * Math.PI), 2), 1 / 3);
    rRes = 2 * aBus - rFinal;
    resAltLabel = "Resonant Ap: " + ((rRes - host.r) / 1000).toFixed(1) + " km";
    const vFinal = circ(host.mu, rFinal);
    const vPe = Math.sqrt(Math.max(0, host.mu * (2 / rFinal - 1 / aBus)));
    maneuverDv = Math.abs(vPe - vFinal);
  }
  
  const resAltKm = (rRes - host.r) / 1000;
  if (resAltKm <= atmo) problems.push("Resonant orbit dips into atmosphere (" + resAltKm.toFixed(1) + " km).");
  if (resAltKm > edge) problems.push("Resonant orbit outside SOI (" + resAltKm.toFixed(0) + " km).");
  
  const moons = Object.keys(raw).filter(n => raw[n].parent === hostName).map(n => ({ name: n, ...raw[n] }));
  const hitMoons = [];
  moons.forEach(m => {
    const mMin = m.sma - m.soi;
    const mMax = m.sma + m.soi;
    const orbMin = Math.min(rRes, rFinal);
    const orbMax = Math.max(rRes, rFinal);
    const altHit = Number.isFinite(alt) && alt > (mMin - host.r) / 1000 && alt < (mMax - host.r) / 1000;
    if (!(orbMax < mMin || orbMin > mMax) || altHit) {
      hitMoons.push(m);
      problems.push((altHit ? "Altitude" : "Resonant orbit") + " crosses " + m.name + " SOI (" + Math.round(mMin / 1000).toLocaleString() + "–" + Math.round(mMax / 1000).toLocaleString() + " km).");
    }
  });

  document.getElementById("relPer").textContent = kDays(tFinal) + " d";
  document.getElementById("relGap").textContent = (360 / nCraft).toFixed(0) + "°";
  document.getElementById("relLink").textContent = dist(link);
  document.getElementById("relResAlt").textContent = resAltLabel;
  document.getElementById("relBus").textContent = kDays(tBus) + " d";
  document.getElementById("relDvManeuver").textContent = fmt(maneuverDv) + " m/s";
  const totalPlacement = (nCraft - 1) * 2 * maneuverDv;
  document.getElementById("relDvTotal").textContent = fmt(totalPlacement) + " m/s";
  document.getElementById("relNote").innerHTML = (problems.length
    ? "<span class='bad'>" + hostName + ": " + problems.join(" ") + "</span>"
    : "<span class='ok'>" + hostName + ": Stable resonant deployment plan. Safe clearance.</span>")
    + "<br><span style='color:var(--dim)'>First relay dropped on initial circularization. Each additional relay = drive + circularize.</span>";

  const fig = problems.length ? "#e06a6a" : "#7dcea0";
  let figEl = document.getElementById("relFig");
  if (isPolar) {
    if (figEl.tagName === "svg") {
      figEl.outerHTML = `<div id="relFig" style="padding:10px 6px;text-align:center;line-height:1.45"><div style="font-size:16px;font-weight:600;color:#7dffa0;margin-bottom:8px">Polar pair</div><div style="font-size:13px;color:#c8e6d0">Body blocks the direct link.<br>Add an equatorial relay<br>to keep them connected.</div></div>`;
    }
  } else {
    if (figEl.tagName !== "svg") {
      figEl.outerHTML = `<svg id="relFig" viewBox="0 0 140 100" width="140" height="100"></svg>`;
      figEl = document.getElementById("relFig");
    }
    const ring = problems.length ? 36 : 46;
    const pts = Array.from({ length: nCraft }, (_, i) => {
      const a = -Math.PI / 2 + i * 2 * Math.PI / nCraft;
      return [70 + Math.cos(a) * ring, 50 + Math.sin(a) * (ring * 0.78)];
    });
    const links = problems.length ? "" : pts.map((p, i) => {
      const q = pts[(i + 1) % nCraft];
      return `<line x1="${p[0]}" y1="${p[1]}" x2="${q[0]}" y2="${q[1]}" stroke="#7dcea0" stroke-width="1.5"/>`;
    }).join("");
    const dots = pts.map(p => `<circle cx="${p[0]}" cy="${p[1]}" r="3.5" fill="${fig}"/>`).join("");
    const moonMark = hitMoons.map((m, i) => {
      const a = Math.PI / 5 + i * 0.6;
      const x = 70 + Math.cos(a) * 34, y = 50 + Math.sin(a) * 26;
      return `<circle cx="${x}" cy="${y}" r="7" fill="${m.color}" stroke="#e06a6a" stroke-width="1.5"/><text x="${x}" y="${y - 10}" text-anchor="middle" fill="${m.color}" font-size="8">${m.name}</text>`;
    }).join("");
    figEl.innerHTML = `<circle cx="70" cy="50" r="16" fill="${host.color}" opacity="0.85"/><circle cx="70" cy="50" r="28" fill="none" stroke="#3a4154"/>${links}${dots}${moonMark}`;
  }
}


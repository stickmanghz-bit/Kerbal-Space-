<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Delta V Planner</title>
<link href="https://fonts.googleapis.com/css2?family=Saira:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root { --ink:#e7f6ea; --dim:#8fb89a; --blue:#3ddc7a; --bg:#0c120e; --panel:#121a14; --card:#182118; --line:#243428; }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.4 Saira, "Segoe UI", sans-serif; }
  
  /* Custom Webkit Scrollbars for Terminal Vibe */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: #2f6a40; border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: #3dcc78; }

  header, .antenna-head { height: 70px; background: #101810; display: flex; align-items: center; gap: 16px; padding: 0 22px; color: #dff6e4; border-bottom: 2px solid #3dcc78; }
  .mark { width: 44px; height: 44px; border-radius: 8px; border: 2px solid #3dcc78; display: grid; place-items: center; font-size: 11px; font-weight: 700; color: #3dcc78; }
  header h1, .antenna-head h1 { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: .14em; }
  .app { display: grid; grid-template-columns: 340px 1fr; height: calc(100vh - 70px); min-height: 640px; }
  aside { background: #0e160f; border-right: 1px solid var(--line); display: flex; flex-direction: column; }
  .journey { flex: 1; overflow: auto; padding: 16px 14px 8px; }
  .origin, .stop { display: flex; align-items: center; gap: 10px; margin: 6px 0; }
  .dot { width: 14px; height: 14px; border-radius: 50%; }
  .card { background: #162016; border-radius: 8px; padding: 12px 14px; margin: 10px 0 10px 22px; display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; border: 1px solid #2a4630; }
  .card b { font-size: 20px; font-weight: 600; color: #d8ffdf; }
  .card span, .lbl { color: var(--dim); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .rm { background: transparent; color: #ff8d7a; border: 0; cursor: pointer; font: 12px Saira, sans-serif; }
  #boot { position: fixed; inset: 0; background: #050805; color: #3dcc78; font: 14px/1.6 "Courier New", monospace; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 40px; opacity: 1; transition: opacity 0.6s ease; }
  #boot.done { opacity: 0; pointer-events: none; }
  #boot pre { margin: 0; white-space: pre-wrap; max-width: 640px; text-align: center; }
  #boot .cursor { display: inline-block; width: 8px; height: 1em; background: #3dcc78; margin-left: 2px; animation: blink 0.7s step-end infinite; vertical-align: text-bottom; }
  @keyframes blink { 50% { opacity: 0; } }
  .foot { display: flex; justify-content: space-between; align-items: center; padding: 14px; border-top: 1px solid var(--line); background: #0a100c; }
  .foot strong, .big { font-size: 28px; font-weight: 600; color: #7dffa0; }
  button.go, .spin button { background: #1a2e1c; color: #dff6e4; border: 1px solid #2f6a40; cursor: pointer; font: 600 13px Saira, sans-serif; }
  button.go { border-radius: 8px; padding: 8px 14px; }
  #dsn, #relays, #relMode { display: flex; gap: 8px; margin-top: 8px; }
  #dsn button, #relays button, #relMode button { flex: 1; border-radius: 8px; padding: 8px 0; font-size: 12px; }
  #relays button { padding: 8px 2px; font-size: 11px; }
  #dsn button.on, #relays button.on, #relMode button.on { background: #3dcc78; color: #061208; border-color: #3dcc78; outline: none; }
  .stage { display: grid; grid-template-rows: 1fr auto; min-height: 0; position: relative; }
  svg#map { width: 100%; height: 100%; background: radial-gradient(circle at 50% 42%, #1a3320 0%, #101810 46%, #070c08 100%); cursor: grab; touch-action: none; }
  
  /* Polished Tooltip with Backdrop Blur and Soft Green Glow */
  #tip { position: absolute; display: none; background: rgba(18,26,20,0.92); backdrop-filter: blur(4px); color: #f4f1ea; border: 1px solid #3dcc78; border-radius: 8px; padding: 8px 10px; font-size: 12px; pointer-events: none; z-index: 5; box-shadow: 0 4px 16px rgba(61,220,120,0.25); }

  .bar { display: flex; gap: 8px; align-items: center; justify-content: center; padding: 6px 8px; background: #101810; border-top: 2px solid #3dcc78; }
  .bar > div:first-child { display: flex; flex-direction: column; gap: 4px; align-items: stretch; width: 100%; max-width: 480px; }
  .toggles { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; width: 460px; }
  .toggles label { display: flex; width: 100%; box-sizing: border-box; justify-content: center; text-align: center; white-space: normal; line-height: 1.2; }
  .bar label:has(input[type="checkbox"]) { gap: 0; margin: 0; padding: 6px 4px; border: 1px solid #2f6a40; border-radius: 6px; background: #1a2e1c; color: #dff6e4; cursor: pointer; font-size: 11px; white-space: nowrap; justify-content: center; text-align: center; width: 100%; box-sizing: border-box; }
  .bar label:has(input[type="checkbox"]:checked) { background: #3dcc78; color: #061208; border-color: #3dcc78; }
  .bar label input[type="checkbox"] { position: absolute; opacity: 0; width: 0; height: 0; }
  
  /* Map Node Glow Effects */
  .node circle { filter: drop-shadow(0 0 4px rgba(61,220,120,0.25)); transition: filter 0.2s; }
  .node:hover circle { filter: drop-shadow(0 0 8px rgba(61,220,120,0.7)); }
  
  .node text { font: 600 10px Saira, sans-serif; fill: #d4f0da; pointer-events: none; }
  .name { font: 600 14px Saira, sans-serif; fill: #f3fff5; pointer-events: none; }
  .antenna { background: #0e160f; border-top: 2px solid #3dcc78; overflow: hidden; }
  .ant-read { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; padding: 16px; align-items: stretch; }
  .transfer-grid { grid-template-columns: repeat(4, 1fr); }
  .win svg { display: block; width: 140px; height: 100px; margin: 8px 0; }
  .stat { background: #142016; border-radius: 8px; padding: 12px 14px; border: 1px solid #2a4630; overflow: hidden; }
  .ant-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding: 0 16px 16px; }
  .ant-card { background: #142016; border-radius: 8px; padding: 12px 14px; border: 1px solid #2a4630; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; }
  .ant-info { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .ant-title { font-weight: 600; font-size: 14px; color: var(--ink); }
  .ant-range { font-size: 11px; color: var(--dim); margin-top: 2px; }
  .ant-badges { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
  .ant-badge { font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: .04em; }
  .badge-direct { background: rgba(224,161,90,.18); color: #7dffa0; }
  .badge-relay { background: rgba(125,206,160,.16); color: #8ee0a8; }
  .ant-ctrl { display: flex; align-items: center; justify-content: space-between; background: #0e160f; border-radius: 8px; padding: 4px 10px; border: 1px solid #2a4630; }
  .spin { display: flex; align-items: center; gap: 8px; }
  .spin button { width: 24px; height: 24px; border-radius: 6px; background: #1a2e1c; color: #dff6e4; border: 0; font-size: 15px; font-weight: 700; display: grid; place-items: center; }
  .spin button:hover { background: #3dcc78; color: #061208; }
  .spin span { font-weight: 600; min-width: 20px; text-align: center; font-variant-numeric: tabular-nums; }
  .ok { color: #8ee0a8; } .bad { color: #ff8d7a; }
  select, input[type="text"] { background: #0e160f; color: #f4f1ea; border: 1px solid #2f6a40; padding: 6px; border-radius: 6px; }
  input[type="range"] { accent-color: #3dcc78; }
  #warn { color: #7dffa0; min-height: 18px; margin: 8px 0 0; }
</style>
</head>
<body>
<div id="boot"><pre id="bootText"></pre><span class="cursor"></span></div>
<script>
(function() {
  const lines = [
    "KERBAL SPACE CENTER  ·  MISSION PLANNER",
    "BIOS v1.4.2  ·  Kerbol System",
    "",
    "Initializing tracking station........ OK",
    "Loading planetary data............... OK",
    "Calibrating transfer windows......... OK",
    "Mapping SOI boundaries............... OK",
    "Checking for the Kraken.............. not found (this time)",
    "  > Kraken status: sleeping. Do not wake.",
    "Waking Jeb............................ he was already awake",
    "Standing by for crew................. READY",
    "",
    "Kerbal Universe online."
  ];
  const el = document.getElementById("bootText");
  let i = 0;
  function next() {
    if (i < lines.length) {
      el.textContent += (i ? "\n" : "") + lines[i++];
      setTimeout(next, i < 3 ? 320 : 400);
    } else {
      setTimeout(() => {
        document.getElementById("boot").classList.add("done");
        setTimeout(() => document.getElementById("boot").remove(), 800);
      }, 900);
    }
  }
  setTimeout(next, 300);
})();
</script>
<header><div class="mark">DV</div><h1>DELTA V PLANNER</h1></header>
<div class="app">
  <aside>
    <div class="journey" id="journey"></div>
    <div class="foot"><div>Total <strong id="total">0 m/s</strong></div><button class="go" id="clear" type="button">Clear</button></div>
  </aside>
  <div class="stage">
    <svg id="map" viewBox="0 0 1100 700"></svg>
    <div id="tip"></div>
    <div class="bar">
      <div>
        <div class="toggles">
          <label data-tip="Start already in low Kerbin orbit instead of launching from the surface. Removes the launch delta-v."><input id="fromLko" type="checkbox" /> Start in LKO</label>
          <label data-tip="Adds a full return leg to Kerbin. Aerobrake Home is forced on unless Orbit Before Landing (Kerbin) is selected."><input id="round" type="checkbox" /> Round Trip</label>
          <label data-tip="Use the destination atmosphere to capture instead of a full propulsive burn. Only available if a body in the journey has an atmosphere."><input id="aeroIn" type="checkbox" /> Aerobrake In</label>
          <label data-tip="Use Kerbin’s atmosphere on the return. Forced on for a direct return. With Orbit Before Landing (Kerbin), choose aero-to-orbit or a full propulsive capture."><input id="aeroHome" type="checkbox" /> Aerobrake Home</label>
          <label data-tip="Cuts landing delta-v on the destination if it has an atmosphere. Does not affect the Kerbin return."><input id="chute" type="checkbox" /> Parachutes</label>
          <label data-tip="Cuts landing delta-v on the Kerbin return. Defaults on for Round Trip (can be turned off). Only available when Round Trip is on."><input id="chuteKerbin" type="checkbox" /> Parachutes (Kerbin)</label>
          <label data-tip="Circularize into orbit at the destination before landing. Off = direct surface entry (no circularization). Works for any body, with or without atmosphere."><input id="orbitFirst" type="checkbox" /> Orbit Before Land</label>
          <label data-tip="Circularize into Kerbin orbit on the return before landing. Off = direct aerobrake. Only available when Round Trip is on."><input id="orbitFirstKerbin" type="checkbox" /> Orbit Before Landing (Kerbin)</label>
        </div>
        <div class="cont-wrap" style="text-align:center;margin-top:4px"><label class="cont">Contingency <b id="conV">0%</b> <input id="con" type="range" min="0" max="50" step="1" value="0" /></label></div>
        <p id="warn"></p>
      </div>
      <div><div class="lbl">Delta-v required</div><div class="big" id="big">0 m/s</div></div>
      <div><div class="lbl">Transfer angle to target</div><div class="big" id="ang">—</div><div class="lbl">Ejection angle (from prograde) <b id="ejectAng">—</b></div></div>
      <div data-tip="Plane change on SOI entry, before capture. You already know the inclination you need (for example 90° polar). Burn far out on the incoming path where speed is low. Auto fills the body’s inclination. Check “Already in orbit” only if you are changing plane from an established low orbit." data-tip-side="left"><div class="lbl">Inclination change</div>
        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
          <input id="di" type="text" inputmode="decimal" value="0" style="width:64px" /> deg
          <button type="button" id="diAuto" class="go" style="padding:2px 8px;font-size:11px">Auto</button>
        </div>
        <div class="lbl" style="margin-top:6px">Burn altitude</div>
        <input id="apo" type="text" inputmode="decimal" value="" placeholder="km" style="width:80px" /> km
        <label style="margin-top:6px !important;width:auto !important;max-width:100%;white-space:normal !important;padding:4px 8px !important;font-size:10px;display:inline-flex !important"><input id="diInOrbit" type="checkbox" /> Already in orbit</label>
        <div class="lbl" id="soiNote"></div>
      </div>
    </div>
  </div>
</div>
<section class="antenna">
  <div class="antenna-head"><div class="mark">S</div><h1>STAGES</h1></div>
  <div class="ant-read" id="stages"></div>
</section>
<section class="antenna">
  <div class="antenna-head"><div class="mark">A</div><h1>ANTENNA & COMMNET</h1></div>
  <div class="ant-read">
    <div class="stat"><div class="lbl">Tracking Station</div>
      <div id="dsn">
        <button type="button" class="go" data-g="2">Level 1 · 2G</button>
        <button type="button" class="go" data-g="50">Level 2 · 50G</button>
        <button type="button" class="go on" data-g="250">Level 3 · 250G</button>
      </div>
    </div>
    <div class="stat"><div class="lbl" id="nearLbl">Closest to Kerbin</div><div class="big" id="near">—</div></div>
    <div class="stat"><div class="lbl" id="farLbl">Farthest from Kerbin</div><div class="big" id="far">—</div></div>
    <div class="stat"><div class="lbl">Your link reaches</div><div class="big" id="rng">—</div><div id="verdict"></div></div>
  </div>
  <div class="ant-grid" id="ants"></div>
</section>
<section class="antenna">
  <div class="antenna-head"><div class="mark">T</div><h1>TRANSFER</h1></div>
  <div class="ant-read transfer-grid">
    <div class="stat win"><div class="lbl">Transfer Window to Target</div><div class="big" id="phase">—</div><svg id="winTo" viewBox="0 0 140 100"></svg><div class="lbl">Arrival periapsis</div><div class="big" id="pe">—</div><div class="lbl" id="peNote"></div></div>
    <div class="stat win"><div class="lbl">Transfer Window from Target</div><div class="big" id="phaseBack">—</div><svg id="winFrom" viewBox="0 0 140 100"></svg><div class="lbl">Return periapsis</div><div class="big" id="peBack">—</div><div class="lbl" id="peBackNote"></div></div>
    <div class="stat"><div class="lbl">Coast</div><div class="big" id="coast">—</div><div class="lbl">Kerbin days, 6 h each</div></div>
    <div class="stat"><div class="lbl">Next window</div><div class="big" id="syn">—</div><div class="lbl" id="winBody">Days between chances</div></div>
  </div>
</section>
<section class="antenna">
  <div class="antenna-head"><div class="mark">R</div><h1>RELAY CONSTELLATION & RESONANT ORBIT</h1></div>
  <div class="ant-read">
    <div class="stat">
      <div class="lbl">Constellation Satellites</div>
      <div id="relays">
        <button type="button" class="go" data-n="2">2</button>
        <button type="button" class="go on" data-n="3">3</button>
        <button type="button" class="go" data-n="4">4</button>
        <button type="button" class="go" data-n="5">5</button>
      </div>
      <div class="lbl" style="margin-top:8px">Deployment Mode</div>
      <div id="relMode">
        <button type="button" class="go on" data-m="in">Drive In (Pe)</button>
        <button type="button" class="go" data-m="out">Drive Out (Ap)</button>
      </div>
      <div class="lbl" style="margin-top:8px">Target Orbit Altitude (km)</div>
      <input id="relAlt" type="text" inputmode="decimal" value="" placeholder="auto" style="width:120px" />
    </div>
    <div class="stat"><div class="lbl">Constellation Geometry</div><svg id="relFig" viewBox="0 0 140 100" width="140" height="100"></svg></div>
    <div class="stat"><div class="lbl">Orbital Period & Spacing</div><div class="big" id="relPer">—</div><div class="lbl">Spacing angle <b id="relGap">—</b></div><div class="lbl">Neighbor range <b id="relLink">—</b></div></div>
    <div class="stat"><div class="lbl">Resonant Maneuver Plan</div><div class="big" id="relResAlt">—</div><div class="lbl">Bus period <b id="relBus">—</b></div><div class="lbl">Maneuver ΔV <b id="relDvManeuver">—</b></div><div class="lbl">Total placement ΔV <b id="relDvTotal">—</b></div><div class="lbl" id="relNote"></div></div>
  </div>
  <div style="padding:0 14px 12px; color:var(--dim); font-size:12px; line-height:1.4; text-align:center">
    <b>Note:</b> Check that the resonant orbit (Drive Out/In) does not cross a moon’s SOI. A crossing can alter the bus timing and break the planned resonance. The warning above will flag any intersection. If you are establishing a relay constellation, add the Total placement ΔV shown above to your overall mission delta-v budget — that is the extra fuel cost for driving and circularizing each additional relay.
  </div>
</section>
<section class="antenna">
  <div class="antenna-head"><div class="mark">P</div><h1>SCIENCE TRANSMISSION POWER</h1></div>
  <div class="ant-read" id="sciencePower">
    <div class="stat" style="grid-column:1/-1"><div class="lbl">Select a destination and antenna above</div></div>
  </div>
  <div style="padding:0 14px 12px; color:var(--dim); font-size:12px; line-height:1.4; text-align:center">
    <b>Note:</b> These figures are the EC cost for a full transmission of one experiment (or M700 scan) with the selected antenna. They do <b>not</b> include continuous draws from the probe core, reaction wheels, lights, or any other systems. Size your batteries for the peak transmission plus your normal vessel load.
  </div>
</section>
<script>
const SUN = 1.1723328e18, KB = { mu: 3.5316e12, r: 600000, sma: 13599840256 };
const raw = {
  Moho:   { mu:1.6860938e11, r:250000, sma:5263138304, inc:7, atm:0, low:20, soi:9646663, parent:"Kerbol", color:"#c46b3a", ang:200 },
  Eve:    { mu:8.1717302e12, r:700000, sma:9832684544, inc:2.1, atm:90, low:100, soi:85109365, parent:"Kerbol", color:"#8e4aa8", ang:150, ascent:8000 },
  Gilly:  { mu:8289449.8, r:13000, sma:31500000, inc:12, atm:0, low:8, soi:126123, parent:"Eve", color:"#c9a0dc" },
  Kerbin: { mu:KB.mu, r:KB.r, sma:KB.sma, inc:0, atm:70, low:80, soi:84159286, parent:"Kerbol", color:"#3c95d4", ang:100, home:true },
  Mun:    { mu:6.5138398e10, r:200000, sma:12000000, inc:0, atm:0, low:14, soi:2429559, parent:"Kerbin", color:"#b7b7b7" },
  Minmus: { mu:1.7658e9, r:60000, sma:47000000, inc:6, atm:0, low:10, soi:2247428, parent:"Kerbin", color:"#7dcea0" },
  Duna:   { mu:3.0136321e11, r:320000, sma:20726155264, inc:0.06, atm:50, low:60, soi:47921949, parent:"Kerbol", color:"#e15b4a", ang:40, ascent:1450 },
  Ike:    { mu:1.8568369e10, r:130000, sma:3200000, inc:0.2, atm:0, low:12, soi:1049599, parent:"Duna", color:"#d0d0d0" },
  Dres:   { mu:2.1484489e10, r:138000, sma:40839348203, inc:5, atm:0, low:12, soi:32832840, parent:"Kerbol", color:"#8d9a72", ang:-10 },
  Jool:   { mu:2.82528e14, r:6000000, sma:68773560320, inc:1.3, atm:200, low:210, soi:2455985200, parent:"Kerbol", color:"#3e9a55", ang:-70, noLand:true },
  Laythe: { mu:1.962e12, r:500000, sma:27184000, inc:0, atm:50, low:60, soi:3723646, parent:"Jool", color:"#3aa8b0", ascent:2900 },
  Vall:   { mu:2.074815e11, r:300000, sma:43152000, inc:0, atm:0, low:15, soi:2406401, parent:"Jool", color:"#6a8fd4" },
  Tylo:   { mu:2.82528e12, r:600000, sma:68500000, inc:0.03, atm:0, low:15, soi:10856518, parent:"Jool", color:"#d0b45a" },
  Bop:    { mu:2.4868349e9, r:65000, sma:128500000, inc:15, atm:0, low:15, soi:1221061, parent:"Jool", color:"#c4a07a" },
  Pol:    { mu:7.2170208e8, r:44000, sma:179890000, inc:4.25, atm:0, low:10, soi:1042139, parent:"Jool", color:"#d2c07a" },
  Eeloo:  { mu:7.4410815e10, r:210000, sma:90118820000, inc:6.15, atm:0, low:15, soi:119082940, parent:"Kerbol", color:"#c8c8c8", ang:-130 }
};
const CX = 550, CY = 350;
const circ = (mu, r) => Math.sqrt(mu / r);
function hohmann(mu, r1, r2) {
  const a = (r1 + r2) / 2;
  return { dv1: Math.abs(Math.sqrt(mu * (2 / r1 - 1 / a)) - circ(mu, r1)), dv2: Math.abs(circ(mu, r2) - Math.sqrt(mu * (2 / r2 - 1 / a))) };
}
const eject = (mu, r, vInf) => Math.sqrt(vInf * vInf + 2 * mu / r) - circ(mu, r);
const fmt = n => Math.round(n).toLocaleString("en-US");
function phase(sma) {
  const a = (KB.sma + sma) / 2, t = Math.PI * Math.sqrt(a ** 3 / SUN), n = Math.sqrt(SUN / sma ** 3);
  let deg = (Math.PI - n * t) * 180 / Math.PI;
  while (deg > 180) deg -= 360;
  while (deg < -180) deg += 360;
  return deg;
}
function phaseBack(sma) {
  const a = (KB.sma + sma) / 2, t = Math.PI * Math.sqrt(a ** 3 / SUN), n = Math.sqrt(SUN / KB.sma ** 3);
  let deg = (Math.PI - n * t) * 180 / Math.PI;
  while (deg > 180) deg -= 360;
  while (deg < -180) deg += 360;
  return deg;
}
function windowFig(angle, color, leaveInner, isOuter) {
  const id = leaveInner ? "to" : "from";
  const cx = 70, cy = 50, rIn = 16, rOut = 34;
  const sun = `<circle cx="${cx}" cy="${cy}" r="7" fill="#f0c84a"/>`;
  if (angle == null) return sun + `<circle cx="${cx}" cy="${cy}" r="${rIn}" fill="none" stroke="#3a4154"/><circle cx="${cx}" cy="${cy}" r="${rOut}" fill="none" stroke="#3a4154"/>`;
  // Real positions: Kerbin is inner for outer targets, outer for inner targets (Moho, Eve)
